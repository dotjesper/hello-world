# .editorconfig - hello-world settings

root = true

# Default settings for all files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown files
[*.md,,*.markdown]
trim_trailing_whitespace = false

# PowerShell files
[*.ps1,,*.psd1,,*.psm1]
indent_size = 4
